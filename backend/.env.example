# ------------------------------------------------------------------
# Backend environment settings — copy this file to `.env` and fill in
# real values:   cp .env.example .env
# (.env is git-ignored — never commit real passwords)
# ------------------------------------------------------------------

# Server port
PORT=5000

# ------------------------------------------------------------------
# Auth — REQUIRED in production. The server refuses to boot with
# NODE_ENV=production unless JWT_SECRET is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a missing JWT_SECRET falls back to a random per-boot
# secret (sessions die on restart).
# ------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
# How long a signed-in session stays valid (jsonwebtoken format: 12h, 7d, ...)
JWT_EXPIRES_IN=12h

# ------------------------------------------------------------------
# Seed admin — created automatically on first boot ONLY when no agent
# account exists yet. Override these, then change the password after
# first sign-in. The default password is for local development only.
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@sayedfarms.com
ADMIN_PASSWORD=change-me-after-first-sign-in

# ------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins.
# Default "*" allows any origin (fine for local dev since auth uses
# Bearer tokens, not cookies). Set this to the real frontend URL(s)
# in production, e.g. https://helpdesk.sayedfarms.com
# ------------------------------------------------------------------
CORS_ORIGIN=*

# ------------------------------------------------------------------
# SMTP — REQUIRED for password reset emails to actually be delivered.
# If these are missing, the app will NOT email reset codes and will
# say so on screen (dev mode shows the code in the app instead).
# ------------------------------------------------------------------

# Office 365 / Outlook (matches your @sayedfarm.com mailbox):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Gmail:            smtp.gmail.com  port 587 (use an App Password, not your login password)
# Zoho:             smtp.zoho.com   port 587
# Generic cPanel:   mail.yourdomain.com port 587 (or 465 with SMTP_SECURE=true)

# The mailbox that will authenticate and send the emails
SMTP_USER=it-helpdesk@sayedfarms.com
SMTP_PASS=replace-with-the-real-mailbox-password

# Only set to true for port 465 (implicit TLS). Leave false for 587.
SMTP_SECURE=false

# The "From" address on outgoing emails. Must be the authenticated
# mailbox itself, or a mailbox/alias this account has "Send As" rights on.
MAIL_FROM="SayedFarms Help Desk <it-helpdesk@sayedfarms.com>"

# Set to "production" in real deployments: hides development fallback
# codes and returns clear errors instead.
NODE_ENV=development

# ------------------------------------------------------------------
# PBX / IP-phone call logging (optional)
# When enabled, every call that reaches the IT office extensions is logged
# (call time, direction, ring time, talk time) and can raise a ticket
# automatically. Leave PBX_ENABLED=false and the rest of the helpdesk behaves
# exactly as before. The PBX here is a Panasonic (KX-NS / NSX / TDA / TDE /
# TD) printing its SMDR call log.
# ------------------------------------------------------------------
PBX_ENABLED=false

# How the records reach the server:
#   off         no feed at all (manual entry + simulator only)
#   auto        tcp-client when PBX_HOST is set, else tcp-server when
#               PBX_LISTEN_PORT is set, else webhook
#   tcp-client  we connect to the PBX's SMDR port        <- KX-NS/NSX, port 2300
#   tcp-server  the PBX / a serial-to-IP gateway wired to the RS-232C SMDR
#               port opens a socket to us and prints records
#   webhook     middleware or a script POSTs the records to /api/pbx/calls
PBX_TRANSPORT=off

# --- tcp-client: Panasonic LAN SMDR -------------------------------
PBX_HOST=192.168.1.10
# 2300 is the SMDR port on the NS/NSX family; if the PBX rejects the
# connection, set 22300 everywhere on the PBX and reboot it.
PBX_PORT=2300
# The SMDR feed logs in before it prints (factory default SMDR / PCCSMDR)
PBX_USERNAME=SMDR
PBX_PASSWORD=PCCSMDR
# Shown in ticket descriptions and reports
PBX_MODEL=Panasonic PBX

# --- tcp-server: serial-to-IP gateway / PBX push -------------------
PBX_LISTEN_HOST=0.0.0.0
PBX_LISTEN_PORT=2300

# --- webhook -------------------------------------------------------
# Shared secret the feeder sends as `X-PBX-Token: ...`.
# Without it, POST /api/pbx/calls only accepts a signed-in IT agent.
PBX_TOKEN=

# Which extensions ring in the IT office (these are the ones that raise
# tickets). Comma-separated, no spaces needed.
PBX_IT_EXTENSIONS=204,205

# When a call raises a ticket:
#   all       every call involving an IT extension (answered, missed,
#             internal, outgoing)                                  <- default
#   answered  only calls that were answered
#   missed    only calls nobody picked up ("I couldn't reach IT")
#   off       log every call, never raise a ticket automatically
PBX_TICKET_POLICY=all

# Ignore calls too short to be a real report (seconds)
PBX_MIN_CALL_SECONDS=5
# Ring duration at which an unanswered call counts as missed (seconds)
PBX_MIN_RING_SECONDS=0

# The category / priority a phone-raised ticket opens with, and an optional
# dispatcher for it (agent account id, email or name)
PBX_TICKET_CATEGORY=Other
PBX_TICKET_PRIORITY=Medium
PBX_DEFAULT_AGENT=

# Date column the PBX console is set to print. `auto` reads both orders;
# Panasonic's own default is MM/DD/YY, European sites use DD/MM/YY, and the
# KX-TDA/TDE/NS "international" setting is YY-MM-DD.
# PBX_DATE_FORMAT=MM-DD-YY
PBX_DAY_FIRST=false

# CSV / middleware feeds only: the field separator and, if the layout is
# unusual, the column positions (1-based, comma-separated `field:column`).
# The default order is the console's own export:
#   Date,Time,Ext,CO,Dial Number,Ring,Duration,Acc code,CD
PBX_SMDR_DELIMITER=,
# PBX_SMDR_COLUMNS=date:1,time:2,ext:3,trunk:4,dialed_number:5,ring_seconds:6,duration_seconds:7,condition_code:8

# Older PBXs print neither a condition code nor an incoming marker. Which way
# should such a record be read — `incoming` (default) or `outgoing`?
PBX_ASSUME_DIRECTION=incoming

# Opt-in: raise tickets for every parsed call even when PBX_IT_EXTENSIONS is
# empty. Only for a PBX already programmed to print the IT extensions alone.
PBX_TICKET_ALL_CALLS=false

# Two records are printed for one intercom call (one per extension); records
# inside this window are merged into one call. Then housekeeping.
PBX_INTERCOM_DEDUPE_WINDOW_SECONDS=180
PBX_RETAIN_CALLS=5000

# The "Simulate call" button in the call log. On by default outside
# production; set true to keep it available on a demo server.
PBX_ALLOW_SIMULATOR=false
