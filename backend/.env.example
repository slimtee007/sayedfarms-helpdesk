# ------------------------------------------------------------------
# Backend environment settings — copy this file to `.env` and fill in
# real values:   cp .env.example .env
# (.env is git-ignored — never commit real passwords)
# ------------------------------------------------------------------

# Server port
PORT=5000

# ------------------------------------------------------------------
# SMTP — REQUIRED for password reset emails to actually be delivered.
# If these are missing, the app will NOT email reset codes and will
# say so on screen (dev mode shows the code in the app instead).
# ------------------------------------------------------------------

# Office 365 / Outlook (matches your @sayedfarm.com mailbox):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Gmail:            smtp.gmail.com  port 587 (use an App Password, not your login password)
# Zoho:             smtp.zoho.com   port 587
# Generic cPanel:   mail.yourdomain.com port 587 (or 465 with SMTP_SECURE=true)

# The mailbox that will authenticate and send the emails
SMTP_USER=it-helpdesk@sayedfarms.com
SMTP_PASS=replace-with-the-real-mailbox-password

# Only set to true for port 465 (implicit TLS). Leave false for 587.
SMTP_SECURE=false

# The "From" address on outgoing emails. Must be the authenticated
# mailbox itself, or a mailbox/alias this account has "Send As" rights on.
MAIL_FROM="SayedFarms Help Desk <it-helpdesk@sayedfarms.com>"

# Set to "production" in real deployments: hides development fallback
# codes and returns clear errors instead.
NODE_ENV=development
